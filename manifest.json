{
  "manifest_version": 3,
  "name": "Accessible AI Browser Navigator",
  "version": "1.1.0",
  "description": "Naviga una pagina in linguaggio naturale: descrivi la destinazione e vai direttamente all'elemento giusto.",
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "commands": {
    "toggle-navigation-input": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Apri la barra di navigazione accessibile"
    }
  }
}